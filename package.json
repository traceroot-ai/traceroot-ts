{
  "name": "traceroot-ts",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter '@traceroot-ai/*' build",
    "test": "pnpm --filter @traceroot-ai/traceroot test",
    "lint": "pnpm --filter '@traceroot-ai/*' lint",
    "typecheck": "pnpm --filter '@traceroot-ai/*' typecheck",
    "clean": "pnpm --filter '@traceroot-ai/*' clean",
    "format": "prettier --write packages/traceroot/src packages/traceroot/tests packages/mastra/src",
    "format:check": "prettier --check packages/traceroot/src packages/traceroot/tests packages/mastra/src",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/*.ts": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "packageExtensions": {
      "@arizeai/openinference-instrumentation-openai": {
        "peerDependencies": {
          "openai": ">=6.0.0"
        }
      }
    },
    "overrides": {
      "@anthropic-ai/sdk@>=0.79.0 <0.91.1": "^0.91.1",
      "@hono/node-server@>=1.0.0 <1.19.15": "^1.19.15",
      "@humanfs/node@>=0.16.0 <0.16.8": "^0.16.8",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "^2.8.0",
      "@opentelemetry/propagator-jaeger@>=2.0.0 <2.9.0": "^2.9.0",
      "@protobufjs/utf8@>=1.0.0 <1.1.1": "^1.1.1",
      "body-parser@>=1.0.0 <1.20.6": "^1.20.6",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "brace-expansion@>=1.0.0 <1.1.18": "^1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "hono@>=4.0.0 <4.12.34": "^4.12.34",
      "ip-address@>=10.0.0 <10.3.1": "^10.3.1",
      "js-yaml@>=3.0.0 <3.15.1": "^3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "langsmith@>=0.5.0 <0.6.0": "^0.6.0",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "protobufjs@>=7.0.0 <7.6.5": "^7.6.5",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "undici@>=8.0.0 <8.9.0": "^8.9.0",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@^3.0.28",
      "@ai-sdk/provider-utils-v6": "npm:@ai-sdk/provider-utils@^4.0.33"
    }
  }
}
